.DS_Store

# Secrets and local environment
.env
.env.*
!.env.example
.direnv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# Editors and notebooks
.idea/
.vscode/
.ipynb_checkpoints/

# Model weights and large tensor artifacts
/model_weights/
/checkpoints/
*.safetensors
*.pt
*.pth
*.ckpt

# Generated experiment artifacts. Keep only the layout documentation in Git.
/artifacts/*
!/artifacts/README.md

# Curated, small result tables and figures may be committed under results/.
/results/**/*.tmp

# Temporary files
*.log
*.tmp
tmp/
