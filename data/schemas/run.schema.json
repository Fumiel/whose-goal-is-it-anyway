{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run.schema.json",
  "title": "Experiment run record v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "condition_id",
    "git_commit",
    "git_dirty",
    "resolved_config_sha256",
    "model",
    "tokenizer",
    "seed",
    "decoding",
    "prefix_records",
    "outcome",
    "scores",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "run_id": { "type": "string", "minLength": 1 },
    "condition_id": { "type": "string", "minLength": 1 },
    "parent_run_id": { "type": ["string", "null"] },
    "git_commit": { "type": "string", "minLength": 7 },
    "git_dirty": { "type": "boolean" },
    "resolved_config_sha256": { "$ref": "#/$defs/sha256" },
    "model": { "$ref": "#/$defs/versionedArtifact" },
    "tokenizer": { "$ref": "#/$defs/versionedArtifact" },
    "seed": { "type": "integer" },
    "decoding": { "type": "object" },
    "prefix_records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/prefixRecord" }
    },
    "outcome": { "$ref": "#/$defs/outcome" },
    "scores": {
      "anyOf": [{ "$ref": "#/$defs/scores" }, { "type": "null" }]
    },
    "failure": {
      "type": ["object", "null"],
      "properties": {
        "stage": { "type": "string" },
        "kind": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "relative_path", "sha256", "bytes"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": ["string", "null"] },
        "kind": { "type": "string", "minLength": 1 },
        "relative_path": { "type": "string", "minLength": 1 },
        "external_uri": { "type": ["string", "null"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 },
        "shape": {
          "type": ["array", "null"],
          "items": { "type": "integer", "minimum": 0 }
        },
        "dtype": { "type": ["string", "null"] }
      }
    },
    "versionedArtifact": {
      "type": "object",
      "required": ["name", "revision"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "position": {
      "type": "object",
      "required": ["name", "token_index", "token_id", "sequence_length", "selection_rule"],
      "properties": {
        "name": { "enum": ["Tpre", "Tpost", "Tend_tool", "Tend_assistant"] },
        "token_index": { "type": "integer", "minimum": 0 },
        "token_id": { "type": "integer", "minimum": 0 },
        "sequence_length": { "type": "integer", "minimum": 1 },
        "selection_rule": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "prefixRecord": {
      "type": "object",
      "required": [
        "boundary",
        "prefix_id",
        "serialized_text_sha256",
        "token_ids",
        "positions"
      ],
      "properties": {
        "boundary": {
          "enum": ["user_to_assistant", "first_tool_to_assistant", "later_tool_to_assistant"]
        },
        "prefix_id": { "type": "string", "minLength": 1 },
        "serialized_text_sha256": { "$ref": "#/$defs/sha256" },
        "token_ids": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "positions": {
          "type": "array",
          "items": { "$ref": "#/$defs/position" }
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "required": ["has_attack", "user_task_success", "attack_success", "group", "baseline_failure", "evaluator_version"],
      "properties": {
        "has_attack": { "type": "boolean" },
        "user_task_success": { "type": "boolean" },
        "attack_success": { "type": "boolean" },
        "group": { "enum": ["A", "B", "C", "D", null] },
        "baseline_failure": { "type": "boolean" },
        "evaluator_version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "candidateSequence": {
      "type": "object",
      "required": [
        "text",
        "token_ids",
        "token_log_probabilities",
        "argument_token_indices",
        "tool_name_token_indices",
        "total",
        "normalized"
      ],
      "properties": {
        "text": { "type": "string" },
        "token_ids": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "token_log_probabilities": { "type": "array", "items": { "type": "number" } },
        "argument_token_indices": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0 }
        },
        "tool_name_token_indices": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0 }
        },
        "total": { "type": "number" },
        "normalized": { "type": "number" }
      },
      "additionalProperties": false
    },
    "scores": {
      "type": "object",
      "required": ["prefix_id", "legitimate", "attack", "margins"],
      "properties": {
        "prefix_id": { "type": "string", "minLength": 1 },
        "legitimate": { "$ref": "#/$defs/candidateSequence" },
        "attack": { "$ref": "#/$defs/candidateSequence" },
        "margins": {
          "type": "object",
          "required": [
            "argument_slot_margin_total",
            "argument_slot_margin_normalized",
            "whole_call_margin_total",
            "whole_call_margin_normalized",
            "first_discriminating_token_margin"
          ],
          "properties": {
            "argument_slot_margin_total": { "type": "number" },
            "argument_slot_margin_normalized": { "type": "number" },
            "whole_call_margin_total": { "type": "number" },
            "whole_call_margin_normalized": { "type": "number" },
            "first_discriminating_token_margin": { "type": "number" },
            "tool_name_margin": { "type": ["number", "null"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
